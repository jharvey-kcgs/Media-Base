{
  "expo": {
    "name": "Media Base",
    "slug": "media-base",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.JHarvey.MediaBase"
    },
    "android": {
      "package": "com.JHarvey.MediaBase",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Media Base uses the camera to scan barcodes so you can add media without typing everything by hand. This is always optional - you can enter items manually instead."
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ]
  }
}
